# RFPlay Airport — Production Environment Variables
# ==================================================
# Copy to .env and fill in real values:
#   cp .env.production .env && nano .env

# JWT secret (REQUIRED — generate: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# Portal/Admin CORS origins (comma-separated)
CORS_ORIGINS=https://rfplay.uk,https://admin.rfplay.uk

# Daemon
DAEMON_NODE_ID=1
DAEMON_MANAGER_TOKEN=

# Optional: enable full profile (daemon + xray)
# COMPOSE_PROFILES=full
