# RFPlay Portal — Multi-stage Docker build for SPA served by Nginx

# --- Stage 1: Build Portal SPA ---
FROM node:22-alpine AS portal-builder

WORKDIR /build/portal
COPY portal/package*.json ./
RUN npm ci
COPY portal/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

# --- Stage 2: Build Admin SPA ---
FROM node:22-alpine AS admin-builder

WORKDIR /build/admin
COPY admin/package*.json ./
RUN npm ci
COPY admin/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

# --- Stage 3: Nginx runtime ---
FROM nginx:1.27-alpine

# Copy built SPAs
COPY --from=portal-builder /build/portal/dist /usr/share/nginx/portal
COPY --from=admin-builder /build/admin/dist /usr/share/nginx/admin

# Copy nginx config (dev default; swap to nginx.conf for production with SSL)
COPY deploy/docker/nginx.conf.dev /etc/nginx/conf.d/default.conf

# Replace main nginx.conf with one that includes stream module support
COPY deploy/docker/nginx-main.conf /etc/nginx/nginx.conf

# Copy stream TCP proxy config for Xray (VMess/VLESS:8443, SOCKS5:1099)
RUN mkdir -p /etc/nginx/stream.conf.d
COPY deploy/docker/stream.conf.dev /etc/nginx/stream.conf.d/xray-stream.conf

# Create certbot webroot
RUN mkdir -p /var/www/certbot

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

EXPOSE 80 443
