# RFPlay Airport — Nginx Development Configuration (Docker, HTTP only)
# For local testing without SSL — xray upstreams use resolver variables

resolver 127.0.0.11 valid=30s;

server {
    listen 80;
    server_name localhost;
    server_tokens off;

    # Portal SPA
    location / {
        root /usr/share/nginx/portal;
        index index.html;
        try_files $uri $uri/ /index.html;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # Admin SPA
    location /admin {
        alias /usr/share/nginx/admin;
        index index.html;
        try_files $uri $uri/ /admin/index.html;

        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
        }
    }

    # Manager API reverse proxy
    location /api/v1/ {
        proxy_pass http://manager:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        proxy_send_timeout    30s;
    }

    # Health check
    location /health {
        proxy_pass http://manager:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Xray WS inbound (optional — resolver variable, no nginx restart needed)
    set $xray_ws "xray:443";
    location /xray/ws {
        proxy_pass http://$xray_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_connect_timeout 60s;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    set $xray_vless "xray:8443";
    location /xray/vless-ws {
        proxy_pass http://$xray_vless;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_connect_timeout 60s;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
