# ============================================================
# Admin Dashboard — Vite environment variables
# Reference: airport_system_design.md §10.5
# ============================================================

# Manager API base URL (used by axios) — must include /api/v1
# Production Pages: relative /api/v1 (same-origin Function → Worker binding)
VITE_API_BASE_URL=/api/v1

# Optional: absolute origin for clipboard subscription URLs (Clash / Base64).
# Defaults to VITE_API_BASE_URL when unset. Prefer the public API host so
# copied links work in client apps (not the admin Pages origin).
# VITE_SUBSCRIPTION_BASE_URL=https://api.rfplay.uk

# Cloudflare Turnstile sitekey (login). Set in CI as secret VITE_TURNSTILE_SITE_KEY.
# VITE_TURNSTILE_SITE_KEY=

