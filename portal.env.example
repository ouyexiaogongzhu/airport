# ============================================================
# Portal (User Website) — Vite environment variables
# Reference: airport_system_design.md §10.4
# ============================================================

# Manager API base URL (used by axios)
VITE_API_BASE_URL=https://api.rfplay.uk

# Optional: base URL for generated subscription links
# (https://.../api/v1/client/links/{token}). Defaults to VITE_API_BASE_URL with
# the /api/v1 prefix appended automatically.
# VITE_SUBSCRIPTION_BASE_URL=https://api.rfplay.uk
