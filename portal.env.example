# ============================================================
# Portal (User Website) — Vite environment variables
# Reference: airport_system_design.md §10.4
# ============================================================

# Manager API base URL (used by axios) — must include /api/v1
# Production Pages: /api/v1 (same-origin → Pages Function → Worker rfplay-api)
# Local vite / direct public API: https://api.rfplay.uk/api/v1
VITE_API_BASE_URL=/api/v1

# Base URL for generated subscription links and Google OAuth start
# (https://.../api/v1/client/links/{token}). Keep the public API host so
# proxy apps / OAuth redirect URIs do not resolve against xv.rfplay.uk.
VITE_SUBSCRIPTION_BASE_URL=https://api.rfplay.uk

# Cloudflare Turnstile sitekey (login/register). Set in CI as secret VITE_TURNSTILE_SITE_KEY.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEpbIStMjRfsMhzq
