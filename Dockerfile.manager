# RFPlay Manager API — Multi-stage Docker build
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /build
COPY manager/ .

# Build with CGO_ENABLED=1 for SQLite
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /build/manager ./cmd/server/

# --- Runtime ---
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata sqlite-libs curl

WORKDIR /app
COPY --from=builder /build/manager .

EXPOSE 8080

ENV PORT=8080
ENV DATA_DIR=/app/data
ENV JWT_SECRET=change-me-in-production

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/manager"]
