# RFPlay — Worker 业务 Secrets 模板
# 复制为 .env 填入真实值后执行：
#   cd workers/api && ../deploy/cloudflare/push-secrets.sh ../../.env
# 真实 .env 永远不要提交。空值的键会被跳过。

# 签发会话 JWT：openssl rand -hex 32
JWT_SECRET=

# BEpusdt（USDT 收款）
BEPUSDT_API_URL=
BEPUSDT_TOKEN=
BEPUSDT_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Cloudflare Turnstile（注册/登录人机校验）
TURNSTILE_SECRET=
