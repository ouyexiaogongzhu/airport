# RFPlay Airport — Environment Template
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# ── Required ─────────────────────────────────────────────────────────
# Long random string used to sign JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Admin panel login (seeded admin user) — only shown once in logs/data dir.
# The first-run admin password is written to DATA_DIR/.admin_password.

# ── Optional but recommended ─────────────────────────────────────────
# CORS origins (comma separated)
CORS_ORIGINS=https://rfplay.uk,https://admin.rfplay.uk

# Node daemon auth token: create a node in the Admin panel, rotate its token
# (POST /api/v1/admin/nodes/:id/token), and paste the returned `nd_...` value.
DAEMON_MANAGER_TOKEN=

# ── Payment providers ────────────────────────────────────────────────
# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# BEpusdt (USDT) — see manager/internal/handler/payment_provider.go
BEPUSDT_API_URL=
BEPUSDT_TOKEN=
BEPUSDT_SECRET=
