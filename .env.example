# RFPlay — Worker 业务 Secrets 模板
# 复制为 .env 填入真实值后执行：
#   cd workers/api && ../deploy/cloudflare/push-secrets.sh ../../.env
# 真实 .env 永远不要提交。空值的键会被跳过。

# 会话 JWT bootstrap（openssl rand -hex 32）。活密钥在 KV jwt:current/previous，由 cron 日轮换。
JWT_SECRET=

# BEpusdt（USDT 收款）
BEPUSDT_API_URL=
BEPUSDT_TOKEN=
BEPUSDT_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Cloudflare Turnstile（注册/登录人机校验）
TURNSTILE_SECRET=

# Google OAuth（Portal Continue with Google；见 docs/oauth-google.md）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 可选覆写；默认 https://api.rfplay.uk/api/v1/public/oauth/google/callback
# GOOGLE_REDIRECT_URI=
