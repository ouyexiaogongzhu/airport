# RFPlay Daemon — Multi-stage Docker build
FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY daemon/ .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /build/daemon ./cmd/main.go

# --- Runtime ---
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /build/daemon .
COPY daemon/data/nodes.json /app/data/nodes.json
COPY daemon/daemon.json /app/daemon.json

EXPOSE 9090

ENV DAEMON_MANAGER_URL=http://manager:8080
ENV DAEMON_LISTEN_ADDR=:9090
ENV DAEMON_NODE_ID=1

ENTRYPOINT ["/app/daemon"]
