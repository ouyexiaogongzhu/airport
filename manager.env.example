# ============================================================
# Manager API — environment variables
# Copy to .env and fill in real values before running.
# Reference: airport_system_design.md §10.3, §14.2, §14A
# ============================================================

# --- Server ---
LISTEN_ADDR=:443
TLS_CERT_FILE=/etc/airport/origin.pem
TLS_KEY_FILE=/etc/airport/origin-key.pem

# --- Origins (CORS) ---
PORTAL_ORIGIN=https://www.rfplay.uk
ADMIN_ORIGIN=https://admin.rfplay.uk
API_PUBLIC_URL=https://api.rfplay.uk

# --- Database ---
DB_PATH=./data/airport.db

# --- Admin Bootstrap (first run only) ---
# Option A: CLI flags  — airport-manager --init-admin --username admin --password '<secure>'
# Option B: Env vars   — uncomment below; remove after first boot
# AIRPORT_BOOTSTRAP_ADMIN_USER=admin
# AIRPORT_BOOTSTRAP_ADMIN_PASS=changeme

# --- HMAC Secret for dynamic tokens (68-byte Option B) ---
# Generate: openssl rand -hex 32
HMAC_SECRET_CURRENT=
HMAC_SECRET_PREVIOUS=

# --- Transactional Email (Resend or Brevo) ---
RESEND_API_KEY=
MAIL_FROM=noreply@rfplay.uk

# --- Payment: BEpusdt ---
BEPUSDT_HOST=
BEPUSDT_AUTH_TOKEN=

# --- Payment: Payoneer ---
PAYONEER_API_KEY=
PAYONEER_MERCHANT_ID=
PAYONEER_WEBHOOK_SECRET=

# --- Cloudflare (optional: Admin panel DNS management) ---
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=

# --- Loki (optional: log push endpoint for Admin charts) ---
LOKI_PUSH_URL=
LOKI_PUSH_TOKEN=
