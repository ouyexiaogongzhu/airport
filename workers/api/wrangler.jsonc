{
  "name": "rfplay-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rfplay",
      "database_id": "e2e30fd5-d9b7-415b-a39d-3352cef000fa"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "8acd30a4721e43a584f252cbacd6526b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "rfplay-backups"
    }
  ],
  // security: mock 回調生產關閉（fail-closed）；本地開發在 .dev.vars 設 "1" 才開啟
  "vars": {
    "MOCK_PAY_ENABLED": "0",
    "PORTAL_URL": "https://www.rfplay.uk",
    "COOKIE_DOMAIN": "rfplay.uk"
  },
  "triggers": { "crons": ["0 * * * *"] },
  // 正式域名：custom_domain=true 時 wrangler 自動建 DNS + 證書（首次上線，直接全量）
  "routes": [
    { "pattern": "api.rfplay.uk", "custom_domain": true }
  ]
}
